{
  "version": 4,
  "configurePresets": [
    {
      "name": "mynyra-offline-release",
      "displayName": "Mynyra offline release",
      "binaryDir": "${sourceDir}/../build/mynyra-offline-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "MYNYRA_OFFLINE_ONLY": "ON",
        "TRADEBOT_ENABLE_LIVE_RUNTIME": "OFF",
        "TRADEBOT_ENABLE_CTRADER_DEMO": "OFF",
        "TRADEBOT_ENABLE_CTRADER_GATE6": "OFF",
        "TRADEBOT_ENABLE_CTRADER_GATE7": "OFF"
      }
    },
    {
      "name": "mynyra-offline-asan",
      "inherits": "mynyra-offline-release",
      "displayName": "Mynyra offline ASan and UBSan",
      "binaryDir": "${sourceDir}/../build/mynyra-offline-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mynyra-offline-release",
      "configurePreset": "mynyra-offline-release"
    },
    {
      "name": "mynyra-offline-asan",
      "configurePreset": "mynyra-offline-asan"
    }
  ],
  "testPresets": [
    {
      "name": "mynyra-offline-release",
      "configurePreset": "mynyra-offline-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mynyra-offline-asan",
      "configurePreset": "mynyra-offline-asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
